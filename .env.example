# Herion POC - Open WebUI

# Local URL: http://localhost:3000
HERION_PORT=3000
WEBUI_NAME=Herion
WEBUI_URL=http://localhost:3000

# Generate a strong value before sharing outside a local POC.
WEBUI_SECRET_KEY=replace-with-a-long-random-secret

# OpenAI API key. Keep this out of git.
OPENAI_API_KEY=sk-your-openai-api-key

# POC access policy:
# - First created account becomes admin.
# - Later signups remain pending until admin approval.
DEFAULT_USER_ROLE=pending
ENABLE_SIGNUP=true
ENABLE_LOGIN_FORM=true

# OAuth/SSO domain restriction.
# This is used when OAuth signup is enabled.
OAUTH_ALLOWED_DOMAINS=kh.or.kr
ENABLE_OAUTH_SIGNUP=false
ENABLE_OAUTH_PERSISTENT_CONFIG=false

# Optional: Microsoft Entra ID OAuth
# Set ENABLE_LOGIN_FORM=false and ENABLE_OAUTH_SIGNUP=true when using OAuth-only login.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:3000/oauth/microsoft/callback

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Track a specific Open WebUI tag for production-like tests.
# main is convenient for POC, but pinning a release is safer later.
OPEN_WEBUI_TAG=main
